      {"path": "/invalid/exitCode", "equals": 2},
      {"path": "/invalid/stderr", "equals": "{\"protocol\":1,\"ok\":false,\"operation\":\"arguments\",\"error\":{\"code\":\"invalid_arguments\",\"message\":\"expected list, get|pause|resume <queueID>, capabilities, inspect-argument <text>, or --version\",\"backend\":null,\"nativeCode\":null,\"outcome\":\"not_submitted\"}}\n"},
      {"path": "/invalid/error", "equals": {"code": "invalid_arguments", "message": "expected list, get|pause|resume <queueID>, capabilities, inspect-argument <text>, or --version", "backend": null, "nativeCode": null, "outcome": "not_submitted"}},
      {"path": "/readOnlyValid", "equals": true},
