      {"path": "/malformedMutation/2/exitCode", "equals": 0},
      {"path": "/malformedMutation/3/stdout", "equals": ""},
      {"path": "/malformedMutation/3/stderr", "equals": "not json"},
      {"path": "/malformedMutation/3/exitCode", "equals": 8},
      {"path": "/rejectedMutations", "length": 5, "each": [
        {"path": "/ok", "equals": false},
        {"path": "/mutation/accepted", "equals": false},
        {"path": "/mutation/observation", "equals": "failed"},
        {"path": "/value/mutation/accepted", "equals": false},
        {"path": "/queue", "absent": true}
      ]},
      {"path": "/rejectedMutations/0/mutation/outcome", "equals": "not_submitted"},
      {"path": "/rejectedMutations/1/mutation/outcome", "equals": "rejected"},
      {"path": "/rejectedMutations/2/mutation/outcome", "equals": "uncertain"},
      {"path": "/rejectedMutations/0/error/outcome", "equals": "not_submitted"},
      {"path": "/rejectedMutations/1/error/outcome", "equals": "rejected"},
      {"path": "/rejectedMutations/2/error/outcome", "equals": "uncertain"},
      {"path": "/rejectedMutations/0/exitCode", "equals": 8},
      {"path": "/rejectedMutations/1/exitCode", "equals": 8},
      {"path": "/rejectedMutations/2/exitCode", "equals": 8},
      {"path": "/rejectedMutations/0/error/code", "equals": "native_error"},
      {"path": "/rejectedMutations/1/error/code", "equals": "native_error"},
      {"path": "/rejectedMutations/2/error/code", "equals": "native_error"},
      {"path": "/rejectedMutations/3/exitCode", "equals": 3},
      {"path": "/rejectedMutations/3/error/code", "equals": "unknown_queue"},
      {"path": "/rejectedMutations/3/error/outcome", "equals": "not_submitted"},
      {"path": "/rejectedMutations/3/mutation/outcome", "equals": "not_submitted"},
      {"path": "/rejectedMutations/3/mutation/error/code", "equals": "unknown_queue"},
