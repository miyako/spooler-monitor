        {"path": "/error/code", "equals": "invalid_argument"},
        {"path": "/error/outcome", "equals": "not_submitted"},
        {"path": "/exitCode", "absent": true}
      ]},
      {"path": "/idLimits", "equals": [true, false, true, false]},
      {"path": "/longQueue/ok", "equals": true},
      {"path": "/longQueue/exitCode", "equals": 0},
