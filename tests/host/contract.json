  "execution": {
    "successPaths": ["/fileArgument", "/folderArgument", "/renamedExecutable"],
    "assertions": [
      {"path": "/renamedExecutable", "equals": {"ok": true, "stdout": "{\"protocol\":1,\"ok\":true,\"operation\":\"version\",\"version\":\"0.1.0\"}\n", "stderr": "", "exitCode": 0}},
      {"path": "/fileArgument/value/operation", "equals": "inspect-argument"},
      {"path": "/folderArgument/value/operation", "equals": "inspect-argument"},
      {"path": "/missing/ok", "equals": false},
      {"path": "/missing/error/code", "equals": "missing_executable"},
      {"path": "/missing/exitCode", "absent": true},
      {"path": "/unsupported/ok", "equals": false},
      {"path": "/unsupported/error/code", "equals": "unsupported_architecture"},
      {"path": "/unsupported/exitCode", "absent": true},
      {"path": "/launch/ok", "equals": false},
      {"path": "/launch/error/code", "equals": "launch_failed"},
      {"path": "/launch/exitCode", "absent": true},
      {"path": "/rejectedArguments", "length": 9, "each": [
        {"path": "/result", "equals": {"ok": false, "error": {"code": "invalid_argument", "message": "Arguments must be Text, File or Folder"}}}
      ]},
      {"path": "/rejectedNul", "length": 3, "each": [
        {"path": "", "equals": {"ok": false, "error": {"code": "invalid_argument", "message": "NUL is not permitted in process arguments"}}}
      ]},
      {"path": "/missingFile", "equals": {"ok": false, "error": {"code": "invalid_argument", "message": "Executable File and arguments Collection are required"}}},
      {"path": "/missingArguments", "equals": {"ok": false, "error": {"code": "invalid_argument", "message": "Executable File and arguments Collection are required"}}}
    ]
  }
}
