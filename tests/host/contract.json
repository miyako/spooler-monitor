{
  "schema": 1,
  "feature": {
    "casesPath": "/cases",
    "caseCount": 2,
    "caseAssertions": [
      {"path": "/value/protocol", "equals": 1},
      {"path": "/value/ok", "equals": true},
      {"path": "/stderr", "equals": ""},
